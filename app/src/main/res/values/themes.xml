<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; this only sets the window colors before the first frame -->
    <style name="Theme.Stundenblick" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <color name="paper">#F5F4F0</color>
    <color name="ink">#14161D</color>
    <color name="blue">#4352E0</color>
    <color name="widget_text">#1B1D24</color>
    <color name="widget_muted">#6B6F7B</color>
    <color name="widget_bg">#F7F6F2</color>
    <string name="widget_description">Heutige Stunden mit Ausfällen und Vertretungen</string>
</resources>
