<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; this only sets the window colors before the first frame -->
    <style name="Theme.Stundenblick" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <color name="paper">#ECE4D0</color>
    <color name="ink">#15100E</color>
    <color name="icon_bg">#15100E</color>
    <color name="widget_text">#15100E</color>
    <color name="widget_muted">#584E45</color>
    <color name="widget_bg">#F4EEE0</color>
    <string name="widget_description">Heutige Stunden mit Ausfällen und Vertretungen</string>
</resources>
